# Public backend base URL; include the existing API path and a trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/
# Optional server-side address for the SAME backend (never sent to the browser).
# API_BASE_URL=http://backend:8000/api/
# Required in production for absolute canonical and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://arbaeentv.com
